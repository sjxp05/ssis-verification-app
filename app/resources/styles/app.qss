/* ===================================================================
   app.qss  —  $${TOKEN} 은 theme.py 에서 치환됨
   =================================================================== */

QWidget {
    font-family: ${FONT_FAMILY};
    font-size: 13px;
    color: ${TEXT};
}

QWidget#Root,
QWidget#PageBody {
    background: ${BG};
}

/* ---------- Header ---------- */
QFrame#HeaderBar {
    background: ${NAVY};
}
QLabel#HeaderTitle {
    color: ${TEXT_ON_NAVY};
    font-size: 15px;
    font-weight: 700;
}
QLabel#HeaderMeta {
    color: ${TEXT_ON_NAVY_MUTED};
    font-size: 12px;
}
QPushButton#HeaderBack {
    color: ${TEXT_ON_NAVY_MUTED};
    background: transparent;
    border: none;
    padding: 4px 8px;
    font-size: 13px;
}
QPushButton#HeaderBack:hover {
    color: ${TEXT_ON_NAVY};
}
QFrame#HeaderDivider {
    background: rgba(255, 255, 255, 0.22);
    max-width: 1px;
}

/* ---------- 시스템 알림 ------------ */
QMessageBox {
    background-color: ${SURFACE};
}

QMessageBox QLabel{
    color: ${TEXT};
}

/* ---------- Step indicator ---------- */
QFrame#StepBar {
    background: ${STEP_BG};
    border-bottom: 1px solid ${BORDER};
}
QLabel#StepArrow {
    color: ${TEXT_MUTED};
    font-size: 13px;
}
QFrame#StepChip {
    border-radius: ${RADIUS_SM};
    background: transparent;
}
QFrame#StepChip[state="current"] {
    background: ${NAVY};
}
QLabel#StepMark {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    background: ${BORDER};
    color: #FFFFFF;
}
QLabel#StepMark[state="done"] {
    background: #2F855A;
    color: #FFFFFF;
}
QLabel#StepMark[state="current"] {
    background: #FFFFFF;
    color: ${NAVY};
}
QLabel#StepText {
    font-size: 13px;
    color: ${TEXT_MUTED};
}
QLabel#StepText[state="done"] {
    color: ${TEXT};
}
QLabel#StepText[state="current"] {
    color: #FFFFFF;
    font-weight: 700;
}

/* ---------- Tabs ---------- */
QPushButton#Tab {
    background: ${STEP_BG};
    color: ${TEXT_MUTED};
    border: 1px solid transparent;
    border-radius: ${RADIUS_SM};
    padding: 8px 18px;
    font-size: 13px;
}
QPushButton#Tab:hover {
    color: ${TEXT};
}
QPushButton#Tab:checked {
    background: ${SURFACE};
    color: ${NAVY};
    border: 1px solid ${BORDER};
    font-weight: 700;
}

/* ---------- Card ---------- */
QFrame#Card {
    background: ${SURFACE};
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS};
}
QFrame#CardHeader {
    background: ${CARD_HEADER_BG};
    border-bottom: 1px solid ${BORDER};
    border-top-left-radius: ${RADIUS};
    border-top-right-radius: ${RADIUS};
}
QLabel#CardTitle {
    font-size: 13px;
    font-weight: 700;
    color: ${TEXT};
}
QLabel#CardHint {
    font-size: 12px;
    color: ${TEXT_MUTED};
}

/* ---------- Section heading ---------- */
QLabel#PageTitle {
    font-size: 17px;
    font-weight: 700;
    color: ${TEXT};
}
QLabel#PageSubtitle {
    font-size: 13px;
    color: ${ACCENT};
}
QLabel#GroupLabel {
    font-size: 13px;
    font-weight: 700;
    color: ${TEXT};
}

/* ---------- Value field ---------- */
QLabel#FieldLabel {
    font-size: 13px;
    color: ${TEXT};
}
QLineEdit#FieldInput {
    background: ${FIELD_BG};
    border: 1px solid ${BORDER};
    border-radius: 12px;
    padding: 5px 12px;
    min-height: 18px;
    color: ${TEXT};
}
QLineEdit#FieldInput:focus {
    border: 1px solid ${NAVY_LIGHT};
}
QLineEdit#FieldInput[modified="true"] {
    border: 1px solid ${ACCENT};
    background: #F2F7FD;
}
QLineEdit#FieldInput[invalid="true"] {
    border: 1px solid #C53030;
    background: #FDF3F3;
}

/* ---------- Table ---------- */
QTableView#DataTable {
    background: ${SURFACE};
    alternate-background-color: #FAFBFC;
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS_SM};
    gridline-color: ${GRID};
    selection-background-color: #D6E6F7;
    selection-color: ${TEXT};
    outline: none;
}
QTableView#DataTable::item {
    padding: 6px 10px;
    border: none;
}
QHeaderView::section:horizontal {
    background: ${NAVY};
    color: ${TEXT_ON_NAVY};
    padding: 9px 10px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.14);
    font-weight: 700;
}
QHeaderView::section:vertical {
    background: #F1F3F5;
    color: ${TEXT_MUTED};
    border: none;
    border-right: 1px solid ${GRID};
    border-bottom: 1px solid ${GRID};
    padding: 4px 8px;
}
QTableCornerButton::section {
    background: ${NAVY};
    border: none;
}

/* ---------- Buttons ---------- */
QPushButton#PrimaryButton {
    background: ${NAVY};
    color: #FFFFFF;
    border: none;
    border-radius: ${RADIUS_SM};
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#PrimaryButton:hover {
    background: ${NAVY_DARK};
}
QPushButton#PrimaryButton:disabled {
    background: #B7BEC7;
    color: #EEF1F4;
}

QPushButton#PillButton {
    background: ${ACCENT_SOFT};
    color: ${NAVY};
    border: none;
    border-radius: 14px;
    padding: 7px 26px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#PillButton:hover {
    background: #BCD8F1;
}

QPushButton#GhostButton {
    background: transparent;
    color: ${NAVY};
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS_SM};
    padding: 9px 16px;
}
QPushButton#GhostButton:hover {
    background: #EDF2F8;
}

/* ---------- Scrollbar ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: ${SCROLLBAR_THUMB};
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: ${NAVY_LIGHT};
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: ${SCROLLBAR_THUMB};
    border-radius: 5px;
    min-width: 30px;
}

/* ---------- Formula bubble ---------- */
QLabel#BubbleTitle {
    color: ${TEXT_MUTED};
    font-size: 11px;
    font-weight: 700;
}
QLabel#BubbleBody {
    color: ${TEXT};
    font-family: ${FONT_MONO};
    font-size: 12px;
}
QLabel#BubbleFoot {
    color: ${TEXT_MUTED};
    font-size: 11px;
}
/* --- 스크롤 페이지 ------------------------------------------------- */
#ScrollPage {
    background: ${BG};
    border: none;
}
#ScrollViewport {
    background: ${BG};
}
#ScrollHolder {
    background: ${BG};
}
#ScrollColumn {
    background: ${BG};
}

/*  Main Page */

QLabel#MainTitle {
    font-size: 24px;
    font-weight: 700;
    color: ${TEXT};
}
QLabel#MainSubtitle {
    font-size: 14px;
    color: ${SUB_TEXT};
    margin-top: 8px;
}

QFrame#YearSelectorBox {
    background: ${SURFACE};
    border-radius: 30px;
    min-width: 280px;
}

QFrame#MenuCard {
    background: ${SURFACE};
    border-radius: 12px;
    min-width: 250px;
    max-width: 270px;
}

QFrame#CardTopLine {
    background: ${NAVY};
    border-radius: 1.5px;
}

QFrame#MenuCard:hover {
    border-top: 3px solid ${NAVY};
    border: 1px solid ${NAVY_LIGHT};
}

QFrame#MenuCard QLabel#MenuArrow {
    color: ${TEXT_MUTED};
    font-size: 15px;
    font-weight: 400;
}

/* 아이콘 (연한 파란색 배경) */
QLabel#MenuIcon {
    background: ${TEXT_GRAY};
    font-size: 22px;
    border-radius: 8px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
}

/* 텍스트 */
QLabel#MenuTitle {
    font-size: 18px;
    font-weight: 700;
    color: ${TEXT};
}
QLabel#MenuDesc {
    font-size: 13px;
    color: ${SUB_TEXT};
    line-height: 1.5;
}

/* 단계 표시 (1, 2, 3 동그라미) */
QLabel#StepBadge {
    background: ${TEXT_GRAY};
    color: ${NAVY};
    font-size: 10px;
    font-weight: 600;
    border-radius: 7.5px;
    border: 1px solid ${NAVY};
    min-width: 15px;
    max-width: 15px;
    min-height: 15px;
    max-height: 15px;
}
QLabel#MenuStepText {
    font-size: 13px;
    color: ${SUB_TEXT};
}

/* 시작하기 버튼 */
QPushButton#MenuStartBtn {
    background: ${NAVY};
    color: ${SURFACE};
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 700;
}

/* --- 하단 안내문 (Info Banner) --- */
QFrame#MainInfoBox {
    background: ${SURFACE};
    min-width: 830px;
    max-width: 880px;
}
QLabel#InfoIcon {
    color: ${NAVY};
    font-size: 16px;
    font-weight: 700;
}
QLabel#InfoText {
    font-size: 13px;
    color: ${SUB_TEXT};
}
/* --- 업로드 카드 ---------------------------------------------------- */
#UploadCard {
    background: ${SURFACE};
    border: 2px dashed ${BORDER};
    border-radius: ${RADIUS_SM};
}
#UploadCard[state="hover"] {
    background: ${ACCENT_SOFT};
    border-color: ${NAVY};
}
#UploadCard[state="done"] {
    background: ${SUCCESS_BG};
    border: 1px solid ${SUCCESS_BORDER};
}
#UploadCard[state="rejected"] {
    background: ${DANGER_BG};
    border-color: ${DANGER};
}

#UploadIcon {
    background: ${ACCENT_SOFT};
    color: ${NAVY};
    border-radius: ${RADIUS_SM};
    font-size: 16px;
}
#UploadIcon[state="done"] {
    background: ${SUCCESS_SOFT};
    color: ${SUCCESS};
}
#UploadIcon[state="rejected"] {
    background: ${DANGER_BG};
    color: ${DANGER};
}

#UploadTitle {
    font-weight: 600;
    font-size: 13px;
    color: ${TEXT};
    background: transparent;
}
#UploadDesc {
    font-size: 11px;
    color: ${TEXT_MUTED};
    background: transparent;
}
#UploadStatus {
    font-size: 11px;
    color: ${TEXT_MUTED};
    padding: 8px 10px;
    background: transparent;
}
#UploadStatus[state="done"] {
    color: ${SUCCESS_DARK};
    background: ${SUCCESS_SOFT};
    border-radius: ${RADIUS_SM};
    font-family: ${FONT_MONO};
}
#UploadStatus[state="rejected"] {
    color: ${DANGER_DARK};
    background: ${DANGER_BG};
    border-radius: ${RADIUS_SM};
}

/* --- 업로드 화면 하단 안내 문구 ------------------------------------- */
#UploadHint {
    font-size: 11px;
    color: ${TEXT_MUTED};
    padding: 4px 0;
}
#UploadHint[state="busy"] {
    color: ${ACCENT};
}
#UploadHint[state="ready"] {
    color: ${SUCCESS_DARK};
}
#UploadHint[state="failed"] {
    color: ${DANGER_DARK};
}
#UploadHint[state="stub"] {
    color: ${SUCCESS_DARK};
    background: ${SUCCESS_BG};
    border: 1px solid ${SUCCESS_BORDER};
    border-radius: ${RADIUS_SM};
    padding: 10px 12px;
}

/* --- 단가표 생성 화면 하단 안내 문구 --------------------------------- */
#GenerateHint {
    font-size: 11px;
    color: ${TEXT_MUTED};
    padding: 4px 0;
}
#GenerateHint[state="busy"] {
    color: ${ACCENT};
}
#GenerateHint[state="ready"] {
    color: ${SUCCESS_DARK};
}
#GenerateHint[state="failed"] {
    color: ${DANGER_DARK};
}

/* --- 잘못된 입력칸 (theme 토큰으로 통일) ---------------------------- */
#FieldInput[invalid="true"] {
    border: 1px solid ${DANGER};
    background: ${DANGER_BG};
}

/* --- 버튼 비활성 상태 ----------------------------------------------- */
/* 이 규칙이 없으면 비활성 버튼이 활성과 똑같이 보여서,
   "두 문서를 다 올려야 진행 가능"이 사용자에게 전달되지 않습니다. */
#PrimaryButton:disabled {
    background: ${CARD_HEADER_BG};
    color: ${TEXT_MUTED};
}
#GhostButton:disabled {
    color: ${TEXT_MUTED};
    border-color: ${BORDER};
}
/* ---------- 검증 사이드 패널 ---------- */
QFrame#ValidationPanel {
    background: ${SURFACE};
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS};
}
QLabel#ValidationTitle {
    font-size: 13px;
    font-weight: 700;
    color: ${TEXT};
}
QLabel#ValidationCaption {
    font-size: 11px;
    font-weight: 700;
    color: ${TEXT_MUTED};
}
QLabel#ValidationBadge {
    font-size: 12px;
    font-weight: 700;
    color: ${TEXT_MUTED};
    background: ${STEP_BG};
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS_SM};
    padding: 8px 10px;
}
QLabel#ValidationBadge[state="pass"] {
    color: ${SUCCESS_DARK};
    background: ${SUCCESS_BG};
    border-color: ${SUCCESS_BORDER};
}
QLabel#ValidationBadge[state="fail"] {
    color: ${DANGER_DARK};
    background: ${DANGER_BG};
    border-color: ${DANGER_BORDER};
}
QListWidget#IssueList {
    background: ${SURFACE};
    border: 1px solid ${BORDER_SOFT};
    border-radius: ${RADIUS_SM};
    outline: none;
    font-size: 12px;
}
QListWidget#IssueList::item {
    padding: 7px 10px;
    border-bottom: 1px solid ${BORDER_SOFT};
    color: ${DANGER_DARK};
}
QListWidget#IssueList::item:hover {
    background: ${DANGER_BG};
}
QListWidget#IssueList::item:selected {
    background: ${DANGER_BG};
    color: ${DANGER_DARK};
    border-left: 3px solid ${DANGER};
}
QScrollArea#ValidationDetailArea {
    background: #FAFBFC;
    border: 1px solid ${BORDER_SOFT};
    border-radius: ${RADIUS_SM};
}
QLabel#ValidationDetail {
    font-family: ${FONT_MONO};
    font-size: 12px;
    color: ${TEXT};
    background: #FAFBFC;
    padding: 10px;
}

/* ---------- 작년 단가표 적용됨 (초록 버튼 상태) ---------- */
QPushButton#GhostButton[state="loaded"] {
    color: ${SUCCESS_DARK};
    background: ${SUCCESS_BG};
    border: 1px solid ${SUCCESS_BORDER};
    font-weight: 700;
}
QPushButton#GhostButton[state="loaded"]:hover {
    background: ${SUCCESS_SOFT};
}

/* ---------- 값 수정 직접 입력칸 ---------- */
QLineEdit#FixInput {
    background: ${SURFACE};
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS_SM};
    padding: 6px 10px;
    font-size: 12px;
    color: ${TEXT};
}
QLineEdit#FixInput:focus {
    border-color: ${ACCENT};
}
/* ---------- 행 추가/삭제 (+/-) — 기호만, 박스 없음 ---------- */
QPushButton#RowButton {
    background: transparent;
    border: none;
    color: ${TEXT_MUTED};
    font-size: 18px;
    font-weight: 700;
    padding: 0px;
}
QPushButton#RowButton:hover {
    color: ${ACCENT};
}
QPushButton#RowButton:pressed {
    color: ${NAVY};
}

/* 고시 원문 뷰어 */
QTextBrowser#NoticeDocument {
    background: ${SURFACE};
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS_SM};
    padding: 10px;
}

/* 스플릿 뷰 핸들러(좌우 분할 구분선) */
QSplitter::handle {
    background: ${BORDER_SOFT};
    width: 4px;
}
QSplitter::handle:hover {
    background: ${NAVY_LIGHT};
}

/* 우측 패널 스크롤 영역 (파이썬 인라인 스타일 대체) */
QScrollArea#NoticeScrollArea,
QWidget#NoticeScrollViewport,
QWidget#NoticeScrollBody {
    background: transparent;
    border: none;
}

/* 대조 결과 요약 텍스트 */
QLabel#CompareSummary {
    font-size: 14px;
    font-weight: 700;
    padding: 12px;
    border-radius: ${RADIUS_SM};
}
QLabel#CompareSummary[state="pass"] {
    color: ${SUCCESS_DARK};
    background: ${SUCCESS_BG};
    border: 1px solid ${SUCCESS_BORDER};
}
QLabel#CompareSummary[state="fail"] {
    color: ${DANGER_DARK};
    background: ${DANGER_BG};
    border: 1px solid ${DANGER_BORDER};
}

/* 검증 상세 내역 및 안내 문구 */
QLabel#FindingDetail {
    font-size: 12px;
    color: ${TEXT_MUTED};
    background: ${SURFACE};
    border: 1px solid ${BORDER_SOFT};
    border-radius: ${RADIUS_SM};
    padding: 12px;
    line-height: 1.5;
}

#CellEditor {
    background: ${SURFACE};
    color: ${NAVY};
    border: 1px solid ${NAVY};
    border-radius: 0;
    padding: 0 6px;
    margin: 0;
}