/* ===================================================================
   app.qss  —  ${TOKEN} 은 theme.py 에서 치환됨
   =================================================================== */

QWidget {
    font-family: ${FONT_FAMILY};
    font-size: 13px;
    color: ${TEXT};
}

QWidget#Root,
QWidget#PageBody {
    background: ${BG};
}

/* ---------- Header ---------- */
QFrame#HeaderBar {
    background: ${NAVY};
}
QLabel#HeaderTitle {
    color: ${TEXT_ON_NAVY};
    font-size: 15px;
    font-weight: 700;
}
QLabel#HeaderMeta {
    color: ${TEXT_ON_NAVY_MUTED};
    font-size: 12px;
}
QPushButton#HeaderBack {
    color: ${TEXT_ON_NAVY_MUTED};
    background: transparent;
    border: none;
    padding: 4px 8px;
    font-size: 13px;
}
QPushButton#HeaderBack:hover {
    color: ${TEXT_ON_NAVY};
}
QFrame#HeaderDivider {
    background: rgba(255, 255, 255, 0.22);
    max-width: 1px;
}

/* ---------- Step indicator ---------- */
QFrame#StepBar {
    background: ${STEP_BG};
    border-bottom: 1px solid ${BORDER};
}
QLabel#StepArrow {
    color: ${TEXT_MUTED};
    font-size: 13px;
}
QFrame#StepChip {
    border-radius: ${RADIUS_SM};
    background: transparent;
}
QFrame#StepChip[state="current"] {
    background: ${NAVY};
}
QLabel#StepMark {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    background: ${BORDER};
    color: #FFFFFF;
}
QLabel#StepMark[state="done"] {
    background: #2F855A;
    color: #FFFFFF;
}
QLabel#StepMark[state="current"] {
    background: #FFFFFF;
    color: ${NAVY};
}
QLabel#StepText {
    font-size: 13px;
    color: ${TEXT_MUTED};
}
QLabel#StepText[state="done"] {
    color: ${TEXT};
}
QLabel#StepText[state="current"] {
    color: #FFFFFF;
    font-weight: 700;
}

/* ---------- Tabs ---------- */
QPushButton#Tab {
    background: ${STEP_BG};
    color: ${TEXT_MUTED};
    border: 1px solid transparent;
    border-radius: ${RADIUS_SM};
    padding: 8px 18px;
    font-size: 13px;
}
QPushButton#Tab:hover {
    color: ${TEXT};
}
QPushButton#Tab:checked {
    background: ${SURFACE};
    color: ${NAVY};
    border: 1px solid ${BORDER};
    font-weight: 700;
}

/* ---------- Card ---------- */
QFrame#Card {
    background: ${SURFACE};
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS};
}
QFrame#CardHeader {
    background: ${CARD_HEADER_BG};
    border-bottom: 1px solid ${BORDER};
    border-top-left-radius: ${RADIUS};
    border-top-right-radius: ${RADIUS};
}
QLabel#CardTitle {
    font-size: 13px;
    font-weight: 700;
    color: ${TEXT};
}
QLabel#CardHint {
    font-size: 12px;
    color: ${TEXT_MUTED};
}

/* ---------- Section heading ---------- */
QLabel#PageTitle {
    font-size: 17px;
    font-weight: 700;
    color: ${TEXT};
}
QLabel#PageSubtitle {
    font-size: 13px;
    color: ${ACCENT};
}
QLabel#GroupLabel {
    font-size: 13px;
    font-weight: 700;
    color: ${TEXT};
}

/* ---------- Value field ---------- */
QLabel#FieldLabel {
    font-size: 13px;
    color: ${TEXT};
}
QLineEdit#FieldInput {
    background: ${FIELD_BG};
    border: 1px solid ${BORDER};
    border-radius: 12px;
    padding: 5px 12px;
    min-height: 18px;
    color: ${TEXT};
}
QLineEdit#FieldInput:focus {
    border: 1px solid ${NAVY_LIGHT};
}
QLineEdit#FieldInput[modified="true"] {
    border: 1px solid ${ACCENT};
    background: #F2F7FD;
}
QLineEdit#FieldInput[invalid="true"] {
    border: 1px solid #C53030;
    background: #FDF3F3;
}

/* ---------- Table ---------- */
QTableView#DataTable {
    background: ${SURFACE};
    alternate-background-color: #FAFBFC;
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS_SM};
    gridline-color: ${GRID};
    selection-background-color: #D6E6F7;
    selection-color: ${TEXT};
    outline: none;
}
QTableView#DataTable::item {
    padding: 6px 10px;
    border: none;
}
QHeaderView::section:horizontal {
    background: ${NAVY};
    color: ${TEXT_ON_NAVY};
    padding: 9px 10px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.14);
    font-weight: 700;
}
QHeaderView::section:vertical {
    background: #F1F3F5;
    color: ${TEXT_MUTED};
    border: none;
    border-right: 1px solid ${GRID};
    border-bottom: 1px solid ${GRID};
    padding: 4px 8px;
}
QTableCornerButton::section {
    background: ${NAVY};
    border: none;
}

/* ---------- Buttons ---------- */
QPushButton#PrimaryButton {
    background: ${NAVY};
    color: #FFFFFF;
    border: none;
    border-radius: ${RADIUS_SM};
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#PrimaryButton:hover {
    background: ${NAVY_DARK};
}
QPushButton#PrimaryButton:disabled {
    background: #B7BEC7;
    color: #EEF1F4;
}

QPushButton#PillButton {
    background: ${ACCENT_SOFT};
    color: ${NAVY};
    border: none;
    border-radius: 14px;
    padding: 7px 26px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#PillButton:hover {
    background: #BCD8F1;
}

QPushButton#GhostButton {
    background: transparent;
    color: ${NAVY};
    border: 1px solid ${BORDER};
    border-radius: ${RADIUS_SM};
    padding: 9px 16px;
}
QPushButton#GhostButton:hover {
    background: #EDF2F8;
}

/* ---------- Scrollbar ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #C3C9D1;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #A9B1BB;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: #C3C9D1;
    border-radius: 5px;
    min-width: 30px;
}

/* ---------- Formula bubble ---------- */
QLabel#BubbleTitle {
    color: ${TEXT_MUTED};
    font-size: 11px;
    font-weight: 700;
}
QLabel#BubbleBody {
    color: ${TEXT};
    font-family: ${FONT_MONO};
    font-size: 12px;
}
QLabel#BubbleFoot {
    color: ${TEXT_MUTED};
    font-size: 11px;
}
